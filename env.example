# ===========================================
# REQUIRED ENVIRONMENT VARIABLES
# ===========================================

# Supabase Configuration (REQUIRED)
# Get these from your Supabase project dashboard at https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Application URLs
# For development use localhost, for production use your deployed URL
NEXT_PUBLIC_APP_URL=https://helloeveryone.vercel.app
NEXT_PUBLIC_SITE_URL=https://helloeveryone.fun
NEXT_PUBLIC_APP_NAME=HelloEveryone.fun

# ===========================================
# AI/ML SERVICES (for matching algorithm)
# ===========================================

# OpenAI Configuration (for semantic matching with embeddings)
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic Configuration (optional - for additional AI features)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# ===========================================
# AUTHENTICATION & OAUTH
# ===========================================

# Google OAuth (optional - for social login)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# NextAuth Configuration (if using NextAuth.js instead of Supabase Auth)
# NEXTAUTH_SECRET=your-random-32-character-secret
# NEXTAUTH_URL=https://helloeveryone.vercel.app

# ===========================================
# EMAIL & COMMUNICATIONS
# ===========================================

# SMTP Configuration (optional - for custom email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=noreply@helloeveryone.fun

# ===========================================
# ANALYTICS & MONITORING
# ===========================================

# Google Analytics (optional)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXX

# Vercel Analytics (recommended for production)
NEXT_PUBLIC_VERCEL_ANALYTICS=true

# Sentry Error Tracking (recommended for production)
NEXT_PUBLIC_SENTRY_DSN=https://your-key@sentry.io/project-id
SENTRY_ORG=your-sentry-organization
SENTRY_PROJECT=helloeveryone
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# PostHog Analytics (optional)
# NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ===========================================
# FEATURE FLAGS & CONFIGURATION
# ===========================================

# PWA Configuration
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=true

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_MATCHING=true
NEXT_PUBLIC_ENABLE_VIDEO_CHAT=false
NEXT_PUBLIC_ENABLE_EVENTS_CALENDAR=true
NEXT_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true

# App Configuration
NEXT_PUBLIC_MAX_PROFILE_PHOTOS=5
NEXT_PUBLIC_MIN_AGE=18
NEXT_PUBLIC_MAX_AGE=80
NEXT_PUBLIC_MAX_DISTANCE_KM=100

# ===========================================
# DEVELOPMENT & DEBUGGING
# ===========================================

# Environment
NODE_ENV=production

# Development Tools
ANALYZE=false
NEXT_PUBLIC_DEBUG_MODE=false

# Database Connection (for local development only)
# DB_PASSWORD=your-local-db-password
# SUPABASE_PROJECT_NAME=helloeveryone-local

# ===========================================
# PRODUCTION DEPLOYMENT NOTES
# ===========================================

# Required for production:
# 1. NEXT_PUBLIC_SUPABASE_URL
# 2. NEXT_PUBLIC_SUPABASE_ANON_KEY
# 3. SUPABASE_SERVICE_ROLE_KEY (for admin operations)
# 4. NEXT_PUBLIC_APP_URL (your deployed URL)

# Recommended for production:
# - NEXT_PUBLIC_SENTRY_DSN (error tracking)
# - OPENAI_API_KEY (for AI matching features)
# - NEXT_PUBLIC_VERCEL_ANALYTICS=true

# Optional but useful:
# - Google OAuth credentials for social login
# - SMTP settings for email notifications
# - Analytics tracking IDs

# ===========================================
# SECURITY NOTES
# ===========================================

# 1. Never commit actual secrets to version control
# 2. Use Vercel dashboard to set production environment variables
# 3. Rotate API keys regularly (quarterly recommended)
# 4. Use different keys for staging vs production
# 5. Monitor API usage to detect any unauthorized access