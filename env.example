# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://amarmxbvuzxakjzvntzv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=somekey
SUPABASE_SERVICE_ROLE_API_KEY=somekey

# OpenAI Configuration (for embeddings)
OPENAI_API_KEY=somekey

# Anthropic Configuration (optional)
ANTHROPIC_API_KEY=somekey

# Database
DB_PASSWORD=somepassword
SUPABASE_PROJECT_NAME=helloeveryone

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=HelloEveryone.fun

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email Configuration (optional - for custom email templates)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Analytics (optional)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
NEXT_PUBLIC_VERCEL_ANALYTICS=true

# Monitoring (optional)
SENTRY_DSN=your-sentry-dsn
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Feature Flags
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=true

# Security
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# Development
NODE_ENV=development
ANALYZE=false