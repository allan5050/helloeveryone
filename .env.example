# ========================================
# REQUIRED ENVIRONMENT VARIABLES
# ========================================
# These variables are required for the application to function

# Supabase Configuration (REQUIRED)
# Get these values from your Supabase project dashboard: https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ========================================
# DEVELOPMENT & ADMIN VARIABLES
# ========================================
# Required for development and admin functionality

# Supabase Service Role Key (Required for admin operations and API routes)
SUPABASE_SERVICE_ROLE_API_KEY=your-service-role-key

# Database Configuration
DB_PASSWORD=your-database-password
SUPABASE_PROJECT_NAME=helloeveryone

# ========================================
# AI/ML INTEGRATION (RECOMMENDED)
# ========================================
# Required for advanced matching features

# OpenAI API Key (Required for semantic matching and embeddings)
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic API Key (Optional - for alternative AI features)
# ANTHROPIC_API_KEY=your-anthropic-api-key

# ========================================
# AUTHENTICATION PROVIDERS (OPTIONAL)
# ========================================
# Configure OAuth providers as needed

# Google OAuth (Optional - for Google sign-in)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_VERIFICATION_ID=your-google-verification-id

# ========================================
# APPLICATION CONFIGURATION (OPTIONAL)
# ========================================
# Optional app configuration variables

# Site URL (Production domain)
# NEXT_PUBLIC_SITE_URL=https://helloeveryone.fun

# App metadata
# NEXT_PUBLIC_APP_URL=https://helloeveryone.fun
# NEXT_PUBLIC_APP_VERSION=1.0.0

# ========================================
# MONITORING & ANALYTICS (OPTIONAL)
# ========================================
# Optional services for monitoring and error tracking

# Sentry for error tracking
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn

# ========================================
# ENVIRONMENT-SPECIFIC NOTES
# ========================================
# 
# DEVELOPMENT:
# - Use http://localhost:3000 for NEXT_PUBLIC_SITE_URL
# - Supabase local development: http://localhost:54321
# - All variables above should be configured
#
# PRODUCTION:
# - Set actual production URLs
# - Never commit actual API keys to version control
# - Use Vercel environment variables or similar
#
# TESTING:
# - Use separate Supabase project for testing
# - Mock API keys or use test keys where available