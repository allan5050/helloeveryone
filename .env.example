# Supabase Configuration
# Get these values from your Supabase project dashboard at https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: OpenAI API Key for semantic matching (if using embeddings)
# OPENAI_API_KEY=sk-your-openai-api-key

# Optional: Sentry for error tracking
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn

# Optional: Google OAuth (if implementing Google sign-in)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional: Custom domain configuration
# NEXT_PUBLIC_SITE_URL=https://helloeveryone.fun

# Development only - Supabase service role key (for admin operations)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Additional environment variables found in codebase
# SUPABASE_SERVICE_ROLE_API_KEY=your-service-role-key
# NEXT_PUBLIC_APP_URL=https://helloeveryone.fun
# NEXT_PUBLIC_APP_VERSION=1.0.0
# GOOGLE_VERIFICATION_ID=your-google-verification-id